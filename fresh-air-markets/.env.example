# Enter real values privately in Vercel Project Settings > Environment Variables.
# Keep all these variables server-side; never prefix them NEXT_PUBLIC_.
DATABASE_URL=
AUTH_SECRET=
# Production inquiries require DATABASE_URL and AUTH_SECRET >=32 characters.
# Apply docs/migrations/002-inquiry-rate-limit.sql before deploying the limiter.
# VERCEL is platform-managed; never set VERCEL=1 on an untrusted self-hosted server.
GHL_API_TOKEN=
GHL_LOCATION_ID=aooAnUXF0COePorBo7wL
GHL_APPLICATION_WEBHOOK_SECRET=
# L06 exact review delivery. Use IDs from the QA pipeline, never stage names.
# The sub-account token needs opportunities.readonly + opportunities.write.
GHL_APPLICATION_PIPELINE_ID=
GHL_APPLICATION_REVIEW_STAGE_ID=
GHL_APPLICATION_APPROVED_STAGE_ID=
GHL_APPLICATION_CHANGES_REQUESTED_STAGE_ID=
GHL_APPLICATION_DECLINED_STAGE_ID=
# A 32+ character secret used only by authenticated recovery/expiry schedulers.
# A protected Preview expiry QA request also needs its private Vercel automation
# bypass capability; do not put that bypass in source, a terminal command
# history, a ticket, or an environment variable of its own.
CRON_SECRET=
# Apply docs/migrations/001-application-handoff.sql, then migrations 004–010
# before enabling review, agreement, or document integrations.
# Both values remain server-side. The notification value is queued only; this
# repository intentionally has no mail transport enabled.
GHL_AGREEMENT_WEBHOOK_SECRET=
GHL_AGREEMENT_TEMPLATE_ID=
GHL_AGREEMENT_NOTIFICATION_EMAIL=
# L07 exact agreement-completion delivery. Use the agreement pipeline's IDs,
# never names; it may differ from the L06 review pipeline.
GHL_AGREEMENT_PIPELINE_ID=
GHL_AGREEMENT_SENT_STAGE_ID=
GHL_AGREEMENT_COMPLETED_STAGE_ID=
# Existing portal accounts.id, not the HighLevel location ID:
# Existing portal account ID; also selects the confirmed Fresh Air calendar.
FAME_MARKET_ACCOUNT_ID=
FAME_SEASON_ID=2026-2027
# Required by the atomic final-reservation writer. Enter the approved market-
# wide booth capacity privately; it intentionally has no default or inference
# from legacy one-booth inquiries.
FAME_BOOTH_CAPACITY=

# The document ingress accepts only metadata from a trusted private transfer
# worker after it streams an upload to private storage and verifies bytes.
# Do not give these values to browsers, HighLevel, or public forms.
DOCUMENT_INGRESS_WEBHOOK_SECRET=
DOCUMENT_SCANNER_WEBHOOK_SECRET=

# Square Sandbox — enter values privately in a Preview environment only.
# A Square website username/password is NOT an API access token.
# Do not add Square values to Production while QA is in progress.
# Before the QA flow, apply the portal chain through 010, then migrations 011–015
# to the isolated QA database in numeric order.
SQUARE_ENVIRONMENT=sandbox
# This must be the exact lower-case value `false`; payment routes fail closed
# if it is missing or differs.
SQUARE_ALLOW_LIVE_PAYMENTS=false
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Optional mismatch guard only. Leave blank for initial Sandbox verification;
# the verified merchant ID is stored with each payment order.
SQUARE_MERCHANT_ID=
# Add only after the deployed webhook route and subscription are verified.
# For a Vercel-protected Preview, this must be the exact endpoint URL including
# its x-vercel-protection-bypass query value. Keep that value only in Vercel
# and the Square Sandbox subscription; never put it in source or chat.
# That bypass can access protected deployments across its QA project, so use a
# dedicated QA capability and rotate or revoke it after QA.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# Preview-only synthetic Square QA controls. Leave every value unset outside
# one isolated case; they must never be configured in Production. Set exactly
# one compatible target with a fault mode, then remove the values and redeploy.
# Checkout faults require SQUARE_QA_FAULT_RESERVATION_ID only.
# Expiry faults require SQUARE_QA_FAULT_PAYMENT_ORDER_ID only.
# Webhook rollback requires SQUARE_QA_FAULT_EVENT_ID and the signer secret only.
# SQUARE_QA_FAULT_MODE=
# SQUARE_QA_FAULT_RESERVATION_ID=
# SQUARE_QA_FAULT_PAYMENT_ORDER_ID=
# SQUARE_QA_FAULT_EVENT_ID=
# SQUARE_QA_SIGNER_SECRET=
