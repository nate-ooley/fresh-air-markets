# Enter real values privately in Vercel Project Settings > Environment Variables.
# Keep all these variables server-side; never prefix them NEXT_PUBLIC_.
#
# PRODUCTION MINIMUM (see docs/production-database-bringup.md):
#   DATABASE_URL + DATABASE_URL_UNPOOLED  Neon Production branch, sslmode=require
#   AUTH_SECRET                            private, at least 32 characters
#   FAME_MARKET_ACCOUNT_ID                 created by database:bootstrap:production
#   FAME_SEASON_ID=2026-2027, FAME_BOOTH_CAPACITY
# Without DATABASE_URL the deployment runs the in-memory demo store and loses
# every account and booking on each cold start. Production never seeds the
# public demo tenant, and the demo login is rejected there.
DATABASE_URL=
# Secret: optional direct Neon connection for reviewed schema migrations.
DATABASE_URL_UNPOOLED=
AUTH_SECRET=
# Production inquiries require DATABASE_URL and AUTH_SECRET >=32 characters.
# Apply docs/migrations/002-inquiry-rate-limit.sql before deploying the limiter.
# VERCEL is platform-managed; never set VERCEL=1 on an untrusted self-hosted server.
# Secret: Fresh Air subaccount Private Integration token. Implemented workers need:
# contacts.readonly, opportunities.readonly, opportunities.write,
# locations/customFields.readonly, conversations/message.readonly,
# conversations/message.write. Planned native document reads also need forms.readonly.
# Exact setup and scope-to-endpoint mapping: docs/highlevel-private-integration-setup.md.
GHL_API_TOKEN=
GHL_LOCATION_ID=aooAnUXF0COePorBo7wL
GHL_APPLICATION_WEBHOOK_SECRET=
# L06 exact review delivery. The base pipeline is Production; Preview uses the
# separate GHL_QA_APPLICATION_PIPELINE_ID defined with the delivery controls below.
# Use stage IDs from the selected pipeline. Token scopes are listed above.
GHL_APPLICATION_PIPELINE_ID=
# Existing Needs Review stage; request_changes stays here and sends no email.
GHL_APPLICATION_REVIEW_STAGE_ID=
GHL_APPLICATION_APPROVED_STAGE_ID=
GHL_APPLICATION_DECLINED_STAGE_ID=
# A 32+ character secret used only by authenticated recovery/expiry schedulers.
# A protected Preview expiry QA request also needs its private Vercel automation
# bypass capability; do not put that bypass in source, a terminal command
# history, a ticket, or an environment variable of its own.
CRON_SECRET=
# Apply migrations 001–021 in numeric order using the database-readiness runner
# (--qa for Preview, --production for Production) before enabling review,
# agreement, document, or payment integrations. Migration 002 is also required
# by the public vendor inquiry limiter, which fails closed (503) without it.
# Both values remain server-side. Agreement completion's internal notification
# value is queued only; it is separate from the payment email delivery adapter.
GHL_AGREEMENT_WEBHOOK_SECRET=
GHL_AGREEMENT_TEMPLATE_ID=
GHL_AGREEMENT_NOTIFICATION_EMAIL=
# L07 uses the same immutable opportunity in the selected application pipeline.
# Optional legacy alias below must equal that pipeline if set; never a separate one.
GHL_AGREEMENT_PIPELINE_ID=
# Config: exact Opportunity custom-field IDs from this HighLevel location.
# Agreement/payment updates keep the application in Approved with status open.
# Token scopes above include locations/customFields.readonly for metadata checks.
GHL_AGREEMENT_STATUS_FIELD_ID=
GHL_PAYMENT_STATUS_FIELD_ID=
# Existing portal accounts.id, not the HighLevel location ID:
# Existing portal account ID; also selects the confirmed Fresh Air calendar.
FAME_MARKET_ACCOUNT_ID=
FAME_SEASON_ID=2026-2027
# Required by the atomic final-reservation writer. Enter the approved market-
# wide booth capacity privately; it intentionally has no default or inference
# from legacy one-booth inquiries.
FAME_BOOTH_CAPACITY=

# The document ingress accepts only metadata from a trusted private transfer
# worker after it streams an upload to private storage and verifies bytes.
# Do not give these values to browsers, HighLevel, or public forms.
DOCUMENT_INGRESS_WEBHOOK_SECRET=
DOCUMENT_SCANNER_WEBHOOK_SECRET=

# Square Sandbox — enter values privately in a Preview environment only.
# A Square website username/password is NOT an API access token.
# Do not add Square values to Production while QA is in progress.
# Before the complete QA flow, apply migrations 001–021 in numeric order
# to the isolated QA database and verify the private market account.
SQUARE_ENVIRONMENT=sandbox
# Preview/Sandbox: exactly `false`. Production live payments: exactly `true`
# together with SQUARE_ENVIRONMENT=production, SQUARE_MERCHANT_ID, the webhook
# key/URL and FAME_VENDOR_PORTAL_ORIGIN below. Any other combination fails closed.
SQUARE_ALLOW_LIVE_PAYMENTS=false
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Config: optional for initial Sandbox verification, required for Production.
# The verified merchant ID is stored with each payment order.
SQUARE_MERCHANT_ID=
# Add only after the deployed webhook route and subscription are verified.
# For a Vercel-protected Preview, this must be the exact endpoint URL including
# its x-vercel-protection-bypass query value. Keep that value only in Vercel
# and the Square Sandbox subscription; never put it in source or chat.
# That bypass can access protected deployments across its QA project, so use a
# dedicated QA capability and rotate or revoke it after QA.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# Payment delivery Config values. Keep both features disabled until the exact
# pipeline, status fields and every downstream notification recipient are verified.
GHL_PAYMENT_SYNC_ENABLED=false
GHL_PAYMENT_EMAIL_ENABLED=false
# qa for Preview; production for Production. Never infer it from a hostname.
GHL_PAYMENT_DELIVERY_MODE=
# A verified sending mailbox; not the QA recipient or administrator override.
GHL_PAYMENT_EMAIL_FROM=
# Exact HTTPS origin that serves this app. Preview: the *.vercel.app host.
# Production: https://freshairmarketsandevents.com, a subdomain of it, or the
# Vercel deployment host such as https://farmers-market-wine.vercel.app.
# SQUARE_WEBHOOK_URL must be this origin + /api/payments/square/webhook.
FAME_VENDOR_PORTAL_ORIGIN=
# Preview-only Config. Omit these entirely from Production.
GHL_QA_APPLICATION_PIPELINE_ID=
# Set true only after native downstream routing has been inspected and proven.
GHL_PAYMENT_QA_ROUTING_VERIFIED=
# The separate GitHub scheduler variable belongs in repository Actions settings;
# its CRON_SECRET must match Vercel. See docs/payment-scheduler.md.

# Preview-only synthetic Square QA controls. Leave every value unset outside
# one isolated case; they must never be configured in Production. Set exactly
# one compatible target with a fault mode, then remove the values and redeploy.
# Checkout faults require SQUARE_QA_FAULT_RESERVATION_ID only.
# Expiry faults require SQUARE_QA_FAULT_PAYMENT_ORDER_ID only.
# Webhook rollback requires SQUARE_QA_FAULT_EVENT_ID and the signer secret only.
# SQUARE_QA_FAULT_MODE=
# SQUARE_QA_FAULT_RESERVATION_ID=
# SQUARE_QA_FAULT_PAYMENT_ORDER_ID=
# SQUARE_QA_FAULT_EVENT_ID=
# SQUARE_QA_SIGNER_SECRET=
